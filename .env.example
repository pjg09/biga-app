# App
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://biga:biga@postgres:5432/biga

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
SECRET_KEY=change-this-to-a-secure-random-string-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Storage — apunta a MinIO en local, a S3 en prod cambiando solo estas variables
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_NAME=biga
STORAGE_REGION=us-east-1

# Email
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=no-reply@biga.app
