# App
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://biga:biga@postgres:5432/biga

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
SECRET_KEY=change-this-to-a-secure-random-string-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Asistencia
# Tope del soporte (PDF/imagen) que el acudiente adjunta al justificar.
JUSTIFICATION_MAX_UPLOAD_MB=5
# Tamaño máximo de una foto de perfil (estudiante o miembro del personal).
PHOTO_MAX_UPLOAD_MB=5
# URL pública del frontend para los enlaces de justificación de inasistencia.
FRONTEND_URL=http://localhost:5173
# Minutos de gracia antes de notificar la inasistencia de primera hora.
# Bajar a 1 en dev para probar el flujo sin esperar 50 minutos.
ATTENDANCE_GRACE_MINUTES=50

# Storage — apunta a MinIO en local, a S3 en prod cambiando solo estas variables
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_NAME=biga
STORAGE_REGION=us-east-1

# Email
# Proveedor de correo: `resend` entrega de verdad; `mailtrap` captura todo en una
# bandeja de pruebas compartida y NO entrega a NINGÚN destinatario real.
# Dejar en `resend` salvo en el entorno de pruebas de los product owners.
EMAIL_PROVIDER=resend

RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=no-reply@biga.app

# Solo con EMAIL_PROVIDER=mailtrap. Credenciales SMTP de la bandeja
# (Mailtrap → Email Testing → tu inbox → Integrations → SMTP).
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASSWORD=

#pae 
PAE_SIGNING_SECRET=una-clave-aleatoria-de-minimo-32-caracteres-aqui


# Leads de la landing: buzón interno que recibe el aviso de solicitud de demo.
# No hay visor dentro del dashboard del colegio: el equipo de BIGA gestiona la
# repartición de demos por fuera de la app.
LEADS_NOTIFY_EMAIL=tu-correo@ejemplo.com
LEADS_RATE_LIMIT_MAX=5
LEADS_RATE_LIMIT_WINDOW_SECONDS=3600

# Recuperacion de contrasena: vida del codigo OTP y del token de cambio,
# intentos permitidos por codigo y limites por IP.
PASSWORD_RESET_OTP_TTL_MINUTES=10
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RATE_LIMIT_MAX=5
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=3600
PASSWORD_RESET_VERIFY_RATE_LIMIT_MAX=20
